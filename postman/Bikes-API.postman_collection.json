{
  "info": {
    "name": "Bikes API - Apresentacao",
    "description": "Collection para apresentacao da API Bikes. Rode as pastas em ordem, da 0 a 6. Os tokens e ids sao salvos automaticamente pelo script de teste de cada request. Antes de comecar: ./mvnw spring-boot:run. ADMIN: admin@bikes.com / 123456.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "clientToken",
      "value": ""
    },
    {
      "key": "clienteUsername",
      "value": "cliente@ifc.edu.br"
    },
    {
      "key": "clientePassword",
      "value": "123456"
    },
    {
      "key": "bikeCodigo",
      "value": "BIKE-001"
    },
    {
      "key": "bikeId",
      "value": ""
    },
    {
      "key": "locacaoId",
      "value": ""
    },
    {
      "key": "locacaoManutencaoId",
      "value": ""
    },
    {
      "key": "bikeManutencaoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 - Login (rodar primeiro)",
      "item": [
        {
          "name": "01 - Login ADMIN (salva token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Esperado: 200",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin@bikes.com\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { pm.collectionVariables.set(\"adminToken\", String(pm.response.json().token)); }"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Criar usuario CLIENTE (publico)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/usuarios",
            "description": "Esperado: 201",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{clienteUsername}}\",\n  \"password\": \"{{clientePassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
